varnishtest "plone_detect_client_ip and plone_forward_client_ip"

# Varnish sees the connection from 127.0.0.1, the proxy in front of it.
# The backend gets only the client in X-Forwarded-For.
server s1 {
    # No proxy in front: only proxies remain, the leftmost is used.
    rxreq
    expect req.http.X-Forwarded-For == "127.0.0.1"
    expect req.http.x-client-ip == <undef>
    txresp

    # Client, then the proxy in front, then Varnish appends 127.0.0.1.
    rxreq
    expect req.http.X-Forwarded-For == "192.0.2.10"
    txresp

    # Addresses the client sent itself are dropped.
    rxreq
    expect req.http.X-Forwarded-For == "192.0.2.10"
    txresp

    # A visitor on an internal network is a client, not a proxy.
    rxreq
    expect req.http.X-Forwarded-For == "192.168.1.9"
    txresp

    # At most the configured number of hops is stripped.
    rxreq
    expect req.http.X-Forwarded-For == "10.0.1.6"
    txresp

    # Garbage on the right is not taken for a proxy.
    rxreq
    expect req.http.X-Forwarded-For == "garbage"
    txresp
} -start

varnish v1 -arg "-p vcc_feature=-err_unref" -vcl+backend {
    include "plone/client.vcl";

    acl plone_proxies { "127.0.0.1"; "10.0.1.0"/24; }
    sub plone_strip_proxies { call plone_strip_proxy; call plone_strip_proxy; }
    acl plone_purge { "127.0.0.1"; }

    sub vcl_recv {
        call plone_detect_client_ip;
        return (pass);
    }
    sub vcl_backend_fetch {
        call plone_forward_client_ip;
    }
} -start

client c1 {
    txreq
    rxresp
    expect resp.status == 200
    txreq -hdr "X-Forwarded-For: 192.0.2.10, 10.0.1.5"
    rxresp
    expect resp.status == 200
    txreq -hdr "X-Forwarded-For: 198.51.100.66, 192.0.2.10, 10.0.1.5"
    rxresp
    expect resp.status == 200
    txreq -hdr "X-Forwarded-For: 192.168.1.9, 10.0.1.5"
    rxresp
    expect resp.status == 200
    txreq -hdr "X-Forwarded-For: 10.0.1.7, 10.0.1.6, 10.0.1.5"
    rxresp
    expect resp.status == 200
    txreq -hdr "X-Forwarded-For: 192.0.2.10, garbage"
    rxresp
    expect resp.status == 200
} -run
