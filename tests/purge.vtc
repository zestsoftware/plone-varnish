varnishtest "plone_purge_allowed"

server s1 {
} -start

varnish v1 -arg "-p vcc_feature=-err_unref" -vcl+backend {
    include "plone/client.vcl";

    acl plone_proxies { "127.0.0.1"; }
    sub plone_strip_proxies { call plone_strip_proxy; }
    acl plone_purge { "127.0.0.1"; }

    sub vcl_recv {
        call plone_detect_client_ip;
        if (req.method == "PURGE") {
            call plone_purge_allowed;
            return (purge);
        }
    }
} -start

client c1 {
    # Directly from an address in plone_purge.
    txreq -req PURGE -url /page
    rxresp
    expect resp.status == 200

    # The same address, but through a proxy.
    txreq -req PURGE -url /page -hdr "X-Forwarded-For: 192.0.2.10"
    rxresp
    expect resp.status == 405
} -run

# Not in plone_purge at all.
varnish v1 -vcl+backend {
    include "plone/client.vcl";

    acl plone_proxies { "127.0.0.1"; }
    sub plone_strip_proxies { call plone_strip_proxy; }
    acl plone_purge { "192.0.2.0"/24; }

    sub vcl_recv {
        call plone_detect_client_ip;
        if (req.method == "PURGE") {
            call plone_purge_allowed;
            return (purge);
        }
    }
}

client c2 {
    txreq -req PURGE -url /page
    rxresp
    expect resp.status == 405
} -run
